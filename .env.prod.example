# Copy to .env.prod and fill in the production values (they differ from
# .env/.env.example at least for ONELIKE_DB_PASSWORD - see application.prod.properties).
# Not auto-loaded by plain `docker-compose up`; pass it explicitly:
#   docker-compose --env-file .env.prod up
# spring-dotenv (pom.xml:33-43) reads `.env` from the working directory, not
# `.env.prod`, so for the prod profile these reach the app as container
# environment variables that docker-compose passes through from the --env-file
# above - or as real platform variables where there is no compose.
#
# This file is USER-AUTHORED. No subagent writes a value here. See CLAUDE.md
# section "Credential handling".

ONELIKE_DB_PASSWORD=
ONELIKE_DB_PASSWORD_DEFAULT=
SPRING_MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
CLOUDFLARE_IMAGES_TOKEN=
HIBP_API_KEY=
WEBSHARE_API_KEY=
ONELIKE_NEWS_FILTER_APIKEY=
