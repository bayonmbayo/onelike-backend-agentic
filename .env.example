# Copy to .env and fill in real values. .env is gitignored and read
# automatically by docker-compose; the Spring Boot app itself needs these as
# actual OS/IDE environment variables (see note in README/CLAUDE.md) - a .env
# file alone is not picked up by `mvn spring-boot:run` without extra tooling.

ONELIKE_DB_PASSWORD=
ONELIKE_DB_PASSWORD_DEFAULT=
SPRING_MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
CLOUDFLARE_IMAGES_TOKEN=
