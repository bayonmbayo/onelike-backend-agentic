# Copy to .env and fill in real values. .env is gitignored, read by
# docker-compose, and ALSO read automatically into Spring's Environment by
# me.paulschwarz:spring-dotenv (see pom.xml:33-43) - so the ${VAR} placeholders
# in application*.properties resolve from this file alone, with no OS or IDE
# variables set. Measured: removing one variable from .env fails context load
# under surefire, which is only possible if this file is read.
#
# This file is USER-AUTHORED. No subagent writes a value here; the loop's only
# business in these files is adding a bare KEY= line below. See CLAUDE.md
# section "Credential handling".

ONELIKE_DB_PASSWORD=
ONELIKE_DB_PASSWORD_DEFAULT=
SPRING_MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
CLOUDFLARE_IMAGES_TOKEN=
HIBP_API_KEY=
WEBSHARE_API_KEY=
ONELIKE_NEWS_FILTER_APIKEY=
